<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launch agent for kbviewer.

  This is a template, not an installable file: the path placeholders below are
  substituted for the absolute path of the checkout at install time. Copying it
  verbatim produces an agent that cannot exec. See deploy/README.md for the one
  command that installs it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kbviewer</string>

  <!--
    The server writes and rotates its own log: 10 MiB, then kbviewer.log.1 to .3.
    launchd never rotates StandardErrorPath, and an agent restarted every ten seconds
    once grew that file to 590 MB, so there is deliberately no StandardOutPath or
    StandardErrorPath here. stderr goes nowhere; the reason a start failed is in the
    log file too. Needs a binary that knows the flag: rebuild before reinstalling this.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>PROJECT_DIR/target/release/kbviewer</string>
    <string>--log-file</string>
    <string>PROJECT_DIR/data/kbviewer.log</string>
  </array>

  <key>WorkingDirectory</key>
  <string>PROJECT_DIR</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>kbviewer=info</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
